{% doc %}
Renders a contact form for customers requesting an update about an unavailable product.
@param {string} id - Product identifier
@param {string} id_form - Form identifier
@param {product} product - Product being requested
@param {variant} current_variant - Currently selected variant
{% enddoc %}
{% assign notification_form_id = id_form | default: id %}
{% assign notification_email_id = 'NotifyEmail-' | append: id %}

{% form 'contact', id: notification_form_id, class: 'notifyMe' %}
  {% if form.posted_successfully? %}
    <p class="notifyMe-text" role="status" aria-live="polite">{{ 'content.form.post_success' | t }}</p>
  {% else %}
    <input type="hidden" name="contact[product_id]" value="{{ id }}">
    <input type="hidden" name="contact[product_title]" value="{{ product.title | escape }}">
    <input type="hidden" name="contact[product_variant]" class="halo-notify-product-variant" value="{{ current_variant.title | escape }}">
    <input type="hidden" name="contact[product_url]" value="{{ request.origin }}{{ product.url }}">
    <label class="visually-hidden" for="{{ notification_email_id }}">{{ 'content.form.email' | t }}</label>
    <input id="{{ notification_email_id }}" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'content.form.email' | t }}" required>
    <button class="button" type="submit">{{ 'content.form.send' | t }}</button>
    <p class="notifyMe-text" role="status" aria-live="polite"></p>
    {% if form.errors %}
      <div class="form__message" role="alert">{{ form.errors | default_errors }}</div>
    {% endif %}
  {% endif %}
{% endform %}

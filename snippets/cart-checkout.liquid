<div class="cart-purchase-conditions" data-purchase-conditions>
  {% render 'purchase-conditions', id_suffix: 'cart-checkout' %}

  <div class="cart__ctas">
    <button
      type="submit"
      id="checkout"
      class="cart__checkout-button button"
      name="checkout"
      {% if cart == empty or settings.enable_purchase_conditions and settings.purchase_conditions_text != blank %}
        disabled
      {% endif %}
      form="cart"
    >
      <span class="button-overflow relative overflow-hidden" data-button-text="{{ 'content.checkout' | t }}">
        <span class="button-text-main inline-block relative z-1">
          {%- if section.settings.enable_mobile_cart_redesign -%}
            <span class="cart-mobile-only cart-mobile-checkout-lock svg-wrapper" aria-hidden="true">
              {{- 'icon-padlock.svg' | inline_asset_content -}}
            </span>
          {%- endif -%}
          {{- 'content.checkout' | t -}}
        </span>
      </span>
    </button>
  </div>

  {%- if additional_checkout_buttons -%}
    <div class="cart__dynamic-checkout-buttons additional-checkout-buttons">
      {{ content_for_additional_checkout_buttons }}
    </div>
  {%- endif -%}
</div>

<div id="cart-errors"></div>

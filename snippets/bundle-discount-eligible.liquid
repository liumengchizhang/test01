{%- doc -%}
  Matches the product list used by the store's automatic Bundle & Save discounts.
  @param {product} product - Product to check.
{%- enddoc -%}
{%- liquid
  assign eligible_ids = '8739499606174,8780950208670,8783283060894,8800412205214,8800599113886,8800599146654,8814408564894,8814409351326,8814410367134,8871151501470,8871163822238,8878283587742,8878521680030,8878548975774,8878598193310,8878606909598,8878630207646,8878711668894,15409297162398,15430898548894' | split: ','
  assign product_id = product.id | append: ''
  assign eligible = false
  if eligible_ids contains product_id
    assign eligible = true
  endif
  echo eligible
-%}

{%- liquid
  assign bundle_product = product
  assign bundle_products = nil
  if bundle_product != blank
    for pairing_rule in section.blocks
      assign rule_matches = false
      for target in pairing_rule.settings.target_products
        if target.id == bundle_product.id
          assign rule_matches = true
          break
        endif
      endfor
      if rule_matches
        assign bundle_products = pairing_rule.settings.companion_products
        break
      endif
    endfor
  endif
  assign related_count = 0
  for related_product in bundle_products limit: 2
    if related_product.id != bundle_product.id and related_product.available
      assign related_count = related_count | plus: 1
    endif
  endfor
-%}
<div hidden data-fbt-global-registry data-product-id="{{ bundle_product.id }}">
  {%- if request.design_mode -%}
    {%- for pairing_rule in section.blocks -%}<span hidden {{ pairing_rule.shopify_attributes }}></span>{%- endfor -%}
  {%- endif -%}
  {%- if related_count > 0 -%}

  {{ 'fbt-bundle.css' | asset_url | stylesheet_tag }}
  <div class="fbt-bundle" data-fbt-bundle>
    <h2 class="fbt-bundle__heading">{{ section.settings.heading | escape }}</h2>
    <p class="fbt-bundle__offers">{{ section.settings.offer_summary | default: 'Buy 2, get 10% OFF · Buy 3, get 15% OFF' | escape }}</p>
    <form class="fbt-bundle__form" data-fbt-form>
      {%- assign current_variant = bundle_product.selected_or_first_available_variant -%}
      {%- assign current_image = current_variant.featured_image | default: bundle_product.featured_image -%}
      {%- capture current_discount_eligible -%}{%- render 'bundle-discount-eligible', product: bundle_product -%}{%- endcapture -%}
      {%- if current_variant and current_variant.available -%}
        <article class="fbt-item" data-fbt-item data-discount-eligible="{{ current_discount_eligible | strip }}" data-product-title="{{ bundle_product.title | escape }}">
          <label class="fbt-item__check">
            <input type="checkbox" checked aria-label="Include {{ bundle_product.title | escape }}">
          </label>
          <a class="fbt-item__image" href="{{ current_variant.url }}">
            {%- if current_image -%}
              {{ current_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '90, 135, 180', alt: current_image.alt | default: bundle_product.title }}
            {%- endif -%}
          </a>
          <div class="fbt-item__details">
            <a class="fbt-item__title" href="{{ current_variant.url }}">{{ bundle_product.title | escape }}</a>
            <div class="fbt-item__price" data-fbt-price>{{ current_variant.price | money }}</div>
            {%- unless bundle_product.has_only_default_variant -%}
            <select class="fbt-item__variant" aria-label="Choose {{ bundle_product.title | escape }} option">
              {%- for variant in bundle_product.variants -%}
                {%- assign variant_image = variant.featured_image | default: bundle_product.featured_image -%}
                <option value="{{ variant.id }}" data-price="{{ variant.price }}" data-variant-url="{{ variant.url | escape }}" {% if variant_image %}data-image-src="{{ variant_image | image_url: width: 360 | escape }}" data-image-alt="{{ variant_image.alt | default: variant.title | escape }}"{% endif %} {% if variant.id == current_variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                  {{ variant.title | escape }}{% unless variant.available %} — Sold out{% endunless %}
                </option>
              {%- endfor -%}
            </select>
            {%- else -%}
              <input type="hidden" class="fbt-item__variant" value="{{ current_variant.id }}" data-price="{{ current_variant.price }}">
            {%- endunless -%}
          </div>
        </article>
      {%- endif -%}

      {%- assign shown_count = 0 -%}
      {%- for related_product in bundle_products limit: 2 -%}
        {%- if related_product.id != bundle_product.id and related_product.available -%}
          {%- assign related_variant = related_product.selected_or_first_available_variant -%}
          {%- assign related_image = related_variant.featured_image | default: related_product.featured_image -%}
          {%- capture related_discount_eligible -%}{%- render 'bundle-discount-eligible', product: related_product -%}{%- endcapture -%}
          {%- if related_variant -%}
            {%- if current_variant and shown_count == 0 -%}<div class="fbt-bundle__plus" aria-hidden="true">+</div>{%- endif -%}
            <article class="fbt-item" data-fbt-item data-discount-eligible="{{ related_discount_eligible | strip }}" data-product-title="{{ related_product.title | escape }}">
              <label class="fbt-item__check">
                <input type="checkbox" checked aria-label="Include {{ related_product.title | escape }}">
              </label>
              <a class="fbt-item__image" href="{{ related_variant.url }}">
                {%- if related_image -%}
                  {{ related_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '90, 135, 180', alt: related_image.alt | default: related_product.title }}
                {%- endif -%}
              </a>
              <div class="fbt-item__details">
                <a class="fbt-item__title" href="{{ related_variant.url }}">{{ related_product.title | escape }}</a>
                <div class="fbt-item__price" data-fbt-price>{{ related_variant.price | money }}</div>
                {%- if related_product.variants.size > 1 -%}
                  <select class="fbt-item__variant" aria-label="Choose {{ related_product.title | escape }} option">
                    {%- for variant in related_product.variants -%}
                      {%- assign variant_image = variant.featured_image | default: related_product.featured_image -%}
                      <option value="{{ variant.id }}" data-price="{{ variant.price }}" data-variant-url="{{ variant.url | escape }}" {% if variant_image %}data-image-src="{{ variant_image | image_url: width: 360 | escape }}" data-image-alt="{{ variant_image.alt | default: variant.title | escape }}"{% endif %} {% if variant.id == related_variant.id %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>
                        {{ variant.title | escape }}{% unless variant.available %} — Sold out{% endunless %}
                      </option>
                    {%- endfor -%}
                  </select>
                {%- else -%}
                  <input type="hidden" class="fbt-item__variant" value="{{ related_variant.id }}" data-price="{{ related_variant.price }}">
                {%- endif -%}
              </div>
            </article>
            {%- assign shown_count = shown_count | plus: 1 -%}
            {%- if shown_count < related_count -%}<div class="fbt-bundle__plus" aria-hidden="true">+</div>{%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}

      <div class="fbt-bundle__footer">
        <p class="fbt-bundle__total" aria-live="polite" aria-atomic="true">{{ section.settings.total_label | escape }} <s class="fbt-bundle__original" data-fbt-original hidden></s> <strong data-fbt-total>{{ 0 | money }}</strong></p>
        <p class="fbt-bundle__offer-note" data-fbt-offer-note data-two-offer="{{ section.settings.two_offer_note | default: '(10% bundle offer on checkout)' | escape }}" data-three-offer="{{ section.settings.three_offer_note | default: '(15% bundle offer on checkout)' | escape }}" hidden></p>
        <p class="fbt-bundle__estimate" data-fbt-estimate hidden>Estimated bundle price. Discounts apply to eligible items only. Final discount confirmed at checkout.</p>
        <p class="fbt-bundle__error" data-fbt-error role="alert" hidden></p>
        <button class="fbt-bundle__button" type="submit" data-fbt-submit>{% if section.settings.button_label == 'Add selected to cart' %}ADD TO CART{% else %}{{ section.settings.button_label | escape }}{% endif %}</button>
      </div>
    </form>
  </div>
  <script src="{{ 'fbt-bundle.js' | asset_url }}" defer="defer"></script>

  {%- endif -%}
</div>
{%- if request.page_type == 'product' or request.design_mode -%}
  <script src="{{ 'fbt-global.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "FBT 全局搭配",
  "limit": 1,
  "enabled_on": {
    "groups": [
      "custom.fbt"
    ]
  },
  "max_blocks": 50,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently Bought Together"
    },
    {
      "type": "text",
      "id": "total_label",
      "label": "Total label",
      "default": "Total price"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "ADD TO CART"
    },
    {
      "type": "text",
      "id": "offer_summary",
      "label": "优惠说明",
      "default": "Buy 2, get 10% OFF · Buy 3, get 15% OFF"
    },
    {
      "type": "text",
      "id": "two_offer_note",
      "label": "勾选两件时提示",
      "default": "(10% bundle offer on checkout)"
    },
    {
      "type": "text",
      "id": "three_offer_note",
      "label": "勾选三件时提示",
      "default": "(15% bundle offer on checkout)"
    }
  ],
  "blocks": [
    {
      "type": "pairing_rule",
      "name": "商品搭配规则",
      "settings": [
        {
          "type": "product_list",
          "id": "target_products",
          "label": "适用商品（可多选）",
          "limit": 50
        },
        {
          "type": "product_list",
          "id": "companion_products",
          "label": "搭配商品",
          "limit": 2
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FBT 全局搭配"
    }
  ]
}
{% endschema %}

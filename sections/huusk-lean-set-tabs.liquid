<huusk-lean-sets class="hlsets color-{{ section.settings.color_scheme }}" data-style="{{ section.settings.tab_style }}" style="--hs-max:{{ section.settings.max_width }}px;--hs-card:{{ section.settings.card_bg }};--hs-title:{{ section.settings.title_color }};--hs-desc:{{ section.settings.description_color }};--hs-eye:{{ section.settings.eyebrow_color }};--hs-bg:{{ section.settings.tab_bg }};--hs-text:{{ section.settings.tab_text }};--hs-border:{{ section.settings.tab_border }};--hs-active:{{ section.settings.active_bg }};--hs-active-text:{{ section.settings.active_text }};--hs-active-border:{{ section.settings.active_border }};--hs-size:{{ section.settings.tab_size }}px;--hs-mobile-size:{{ section.settings.tab_mobile_size }}px;--hs-radius:{{ section.settings.tab_radius }}px;--hs-bw:{{ section.settings.tab_border_width }}px;--hs-x:{{ section.settings.tab_x }}px;--hs-y:{{ section.settings.tab_y }}px;--hs-gap:{{ section.settings.tab_gap }}px;--hs-bottom:{{ section.settings.tab_bottom }}px;--hs-heading:{{ section.settings.title_size }}px;--hs-body:{{ section.settings.body_size }}px;--hs-price:{{ section.settings.price_size }}px;--hs-colgap:{{ section.settings.card_gap }}px;--hs-rowgap:{{ section.settings.row_gap }}px;--hs-card-radius:{{ section.settings.card_radius }}px;--hs-button:{{ section.settings.button_bg }};--hs-button-text:{{ section.settings.button_text }};--hs-gradient:{{ section.settings.button_gradient | default: section.settings.button_bg }};padding-block:{{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;">
  <div class="hlsets__inner">
    <div class="hlsets__tabs" role="tablist" aria-label="{{ section.settings.tab_1 | escape }} / {{ section.settings.tab_2 | escape }}">
      {% for number in (1..2) %}
        {% assign label_key = 'tab_' | append: number %}
        <button type="button" role="tab" id="hs-tab-{{ section.id }}-{{ number }}" aria-controls="hs-panel-{{ section.id }}-{{ number }}" aria-selected="{% if number == 1 %}true{% else %}false{% endif %}" tabindex="{% if number == 1 %}0{% else %}-1{% endif %}" data-hs-tab="{{ number }}">{{ section.settings[label_key] | escape }}</button>
      {% endfor %}
    </div>
    {% for number in (1..2) %}
      {% assign panel_key = number | append: '' %}
      <div class="hlsets__panel" id="hs-panel-{{ section.id }}-{{ number }}" role="tabpanel" aria-labelledby="hs-tab-{{ section.id }}-{{ number }}" data-hs-panel="{{ number }}" {% if number == 2 %}hidden{% endif %}>
        {% for block in section.blocks %}
          {% if block.settings.panel == panel_key %}
            <article class="hlsets__card" {{ block.shopify_attributes }}>
              {% if block.settings.image != blank %}<div class="hlsets__media">{{ block.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360, 540, 720, 960, 1200', sizes: '(min-width: 750px) 33vw, 100vw' }}</div>{% endif %}
              <div class="hlsets__body">
                <div class="hlsets__eyebrow">{{ block.settings.eyebrow }}</div>
                {% if block.settings.title != blank %}<h3>{{ block.settings.title | escape }}</h3>{% endif %}
                <div class="hlsets__description">{{ block.settings.description }}</div>
                <div class="hlsets__prices">
                  {% if block.settings.original_price != blank %}
                     <span class="hlsets__original">
                        {{ block.settings.original_price | escape }}
                      </span>
                    {% endif %}
                    <span class="hlsets__price">
                      {{ block.settings.price | escape }}
                    </span>
                  </div>
                {% if block.settings.button_label != blank and block.settings.link != blank %}<a class="hlsets__button" href="{{ block.settings.link }}">{{ block.settings.button_label | escape }}</a>{% endif %}
                {% if block.settings.icon != 'none' and block.settings.icon != blank %}<div class="hlsets__icon">{% render 'icon-or-image', icon: block.settings.icon, width: 24 %}</div>{% endif %}
              </div>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    {% endfor %}
  </div>
</huusk-lean-sets>
<style>
.hlsets{display:block;width:100%;box-sizing:border-box;background:var(--color-background);color:var(--color-foreground)}.hlsets *{box-sizing:border-box}.hlsets__inner{width:min(var(--hs-max),100% - 40px);margin-inline:auto}.hlsets__tabs{display:flex;justify-content:center;flex-wrap:wrap;gap:var(--hs-gap);margin-bottom:var(--hs-bottom)}.hlsets__tabs button{appearance:none;font:inherit;font-size:var(--hs-size);font-weight:500;line-height:1.3;padding:var(--hs-y) var(--hs-x);min-height:44px;max-width:100%;border:var(--hs-bw) solid var(--hs-border);border-radius:var(--hs-radius);background:var(--hs-bg);color:var(--hs-text);cursor:pointer}.hlsets__tabs button[aria-selected=true]{background:var(--hs-active);color:var(--hs-active-text);border-color:var(--hs-active-border)}.hlsets[data-style=outline] button[aria-selected=false]{background:transparent}.hlsets[data-style=underline] .hlsets__tabs button{background:transparent;border:0;border-bottom:var(--hs-bw) solid var(--hs-border);border-radius:0}.hlsets[data-style=underline] button[aria-selected=true]{border-bottom-color:var(--hs-active-border)}.hlsets__tabs button:focus-visible,.hlsets__button:focus-visible{outline:2px solid currentColor;outline-offset:4px}.hlsets__panel{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--hs-rowgap) var(--hs-colgap)}.hlsets__panel[hidden]{display:none!important}.hlsets__card{min-width:0;overflow:hidden;display:flex;flex-direction:column;border-radius:var(--hs-card-radius);background:var(--hs-card);padding-block:30px}.hlsets__media img{display:block;width:100%;height:auto}.hlsets__body{padding:10px 20px 0;display:flex;flex-direction:column;gap:5px;flex:1}.hlsets__body p{margin:0}.hlsets__eyebrow{color:var(--hs-eye);font-size:var(--hs-body)}.hlsets__body h3{font-family:var(--font-heading--family);font-size:var(--hs-heading);line-height:1.2;color:var(--hs-title);margin:0}.hlsets__description{font-size:var(--hs-body);color:var(--hs-desc);padding-bottom:10px}.hlsets__prices{display:flex;align-items:flex-end;flex-wrap:wrap;gap:8px;color:var(--hs-title)}.hlsets__price{font-size:var(--hs-price);font-weight:700;line-height:1.3}.hlsets__original{font-size:16px;text-decoration:line-through;opacity:.8}.hlsets__button{align-self:flex-start;margin-top:10px;border-radius:100px;padding:10px 20px;min-height:44px;display:inline-flex;align-items:center;justify-content:center;background:var(--hs-button);background:var(--hs-gradient);color:var(--hs-button-text);text-decoration:none;font-size:14px;line-height:1.3}.hlsets__icon{margin-top:12px}.hlsets__icon:empty{display:none}@media(max-width:749px){.hlsets__panel{grid-template-columns:minmax(0,1fr)}.hlsets__tabs button{font-size:var(--hs-mobile-size)}}
</style>
<script>
if(!customElements.get('huusk-lean-sets'))customElements.define('huusk-lean-sets',class extends HTMLElement{
connectedCallback(){this.abort?.abort();this.abort=new AbortController();const signal=this.abort.signal;this.tabs=[...this.querySelectorAll('[data-hs-tab]')];this.panels=[...this.querySelectorAll('[data-hs-panel]')];this.addEventListener('click',e=>{const t=e.target.closest('[data-hs-tab]');if(t)this.select(t.dataset.hsTab)},{signal});this.addEventListener('keydown',e=>{const t=e.target.closest('[data-hs-tab]');if(!t)return;const k=e.key;if(!['ArrowLeft','ArrowRight','Home','End'].includes(k))return;e.preventDefault();const n=k==='Home'?'1':k==='End'?'2':t.dataset.hsTab==='1'?'2':'1';this.select(n);this.tabs.find(x=>x.dataset.hsTab===n).focus()},{signal});document.addEventListener('shopify:block:select',e=>{const p=e.target.closest('[data-hs-panel]');if(p&&this.contains(p))this.select(p.dataset.hsPanel)},{signal})}
select(n){this.tabs.forEach(t=>{const on=t.dataset.hsTab===n;t.setAttribute('aria-selected',on);t.tabIndex=on?0:-1});this.panels.forEach(p=>p.hidden=p.dataset.hsPanel!==n)}
disconnectedCallback(){this.abort?.abort()}
});
</script>

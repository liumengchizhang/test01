{% doc %}
  @prompt
    生成一个独属于一个产品落地页的、在画面底部的满幅长条弹窗，里面有背景颜色，标题及字体大小颜色，文本及字体大小颜色，加入购物车按钮，产品图，价格，布局：图片在左上，大小可调，价格在图片下方，上下左右可调，最右是加购按钮, 增加价格颜色选项，把×放到右上角，颜色可选, 价格字号也要可选, 把价格放到标题和文本下面，左边才是图片, 标题字体可选, 标题和价格各增加可选字重, 要看产品信息时不出现，划过产品信息弹上来, 标题字体和文本字体要在标题/副标题/文本中选, 再增加一个间隙大小选项，主要是为了增加标题文本和价格之间的间隙, 价格在标题和文本下面，图片的右边, 移动段布局是左上图片，右上是左对齐的标题、文本和价格，图片的最上端和标题的最上端对齐，图片最下端和价格最下端对齐，下面是一整长条按钮。, 移动端图片还是正方形, 选项栏可翻译成中文, 图片尺寸分为电脑端和移动端, 桌面端和移动端图片比例始终保持1：1, ×增加一个悬停颜色选项, 标题字号也分为移动端和电脑端, 移动端的：图片加标题文本和价格，再加按钮，这些所有内容一起，右边不要留太多空白，参考左边边距，左右间距要一致, 标题和按钮字体可从（标题/副标题/文本）中选，其余不变, 不止单一产品，所有产品落地页都需要这个分区，产品信息根据不同产品落地页自动调整, 电脑端内容左右边距只留20, 电脑端：内容满幅，左右不要留太多边距, 左右边距再多10, 电脑端：内容满幅，左右不要留太多边距，保持和顶部边距相同即可
    移动端：加购按钮改成横条一整条，最右和标题最右对齐, 电脑端：内容满幅，左右不要留太多边距，左右边距留20，保持和顶部边距相同即可
    移动端：加购按钮改成横条一整长条，按钮最右端和标题最右端对齐, 标题和按钮字体怎么改不动，其余完全不变, 按钮和图片增加圆角选项，其余完全不变
{% enddoc %}
{% doc %}{% enddoc %}{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% assign form_class = 'ai-sticky-buy-' | append: ai_gen_id | append: '__form' %}{% assign title_font_family = settings.type_header_font.family %}{% assign button_font_family = settings.type_body_font.family %}{% case block.settings.title_font %}{% when 'subheading' %}{% assign title_font_family = settings.type_subheading_font.family %}{% when 'body' %}{% assign title_font_family = settings.type_body_font.family %}{% endcase %}{% case block.settings.button_font %}{% when 'heading' %}{% assign button_font_family = settings.type_header_font.family %}{% when 'subheading' %}{% assign button_font_family = settings.type_subheading_font.family %}{% endcase %}{% if request.page_type == 'product' and product != blank %}{% assign active_variant = product.selected_or_first_available_variant %}{% style %}.ai-sticky-buy-{{ ai_gen_id }}{display:block;position:fixed;z-index:30;left:0;right:0;bottom:0;width:100%;padding:20px;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};box-shadow:0 -4px 24px rgba(0,0,0,.12);transform:translateY(110%);visibility:hidden;transition:transform .25s ease,visibility .25s ease}.ai-sticky-buy-{{ ai_gen_id }}.is-visible{transform:translateY(0);visibility:visible}.ai-sticky-buy-{{ ai_gen_id }}__inner{display:flex;align-items:center;gap:20px;width:100%;margin:0}.ai-sticky-buy-{{ ai_gen_id }}__image{width:{{ block.settings.image_size }}px;aspect-ratio:1;flex:0 0 auto;object-fit:cover;border-radius:{{ block.settings.image_radius }}px}.ai-sticky-buy-{{ ai_gen_id }}__copy{flex:1;min-width:0}.ai-sticky-buy-{{ ai_gen_id }}__title{margin:0 0 6px;color:{{ block.settings.title_color }};font-size:{{ block.settings.title_size }}px;font-weight:{{ block.settings.title_weight }};font-family:{{ title_font_family }},sans-serif}.ai-sticky-buy-{{ ai_gen_id }}__text{margin:0 0 {{ block.settings.copy_price_gap }}px;color:{{ block.settings.text_color }};font-size:{{ block.settings.text_size }}px}.ai-sticky-buy-{{ ai_gen_id }}__price{color:{{ block.settings.price_color }};font-size:{{ block.settings.price_size }}px;font-weight:{{ block.settings.price_weight }}}.ai-sticky-buy-{{ ai_gen_id }}__form{flex:0 0 auto}.ai-sticky-buy-{{ ai_gen_id }}__button{min-height:48px;padding:12px 28px;border:0;border-radius:{{ block.settings.button_radius }}px;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};font-size:16px;font-family:{{ button_font_family }},sans-serif;cursor:pointer}.ai-sticky-buy-{{ ai_gen_id }}__close{position:absolute;top:8px;right:8px;padding:6px;border:0;background:transparent;color:{{ block.settings.close_color }};font-size:24px;line-height:1;cursor:pointer}.ai-sticky-buy-{{ ai_gen_id }}__close:hover{color:{{ block.settings.close_hover_color }}}@media(max-width:749px){.ai-sticky-buy-{{ ai_gen_id }}{padding:20px}.ai-sticky-buy-{{ ai_gen_id }}__inner{display:grid;grid-template-columns:{{ block.settings.mobile_image_size }}px minmax(0,1fr);align-items:start;column-gap:12px;row-gap:12px}.ai-sticky-buy-{{ ai_gen_id }}__image{width:{{ block.settings.mobile_image_size }}px;grid-column:1;grid-row:1}.ai-sticky-buy-{{ ai_gen_id }}__copy{grid-column:2;grid-row:1;padding-right:20px}.ai-sticky-buy-{{ ai_gen_id }}__title{font-size:{{ block.settings.mobile_title_size }}px}.ai-sticky-buy-{{ ai_gen_id }}__form{grid-column:1/-1;width:100%}.ai-sticky-buy-{{ ai_gen_id }}__button{display:block;width:100%}}{% endstyle %}<sticky-buy-bar-{{ ai_gen_id }} class="ai-sticky-buy-{{ ai_gen_id }}"><button class="ai-sticky-buy-{{ ai_gen_id }}__close" type="button" aria-label="关闭">×</button><div class="ai-sticky-buy-{{ ai_gen_id }}__inner" {{ block.shopify_attributes }}>{% if product.featured_image %}<img class="ai-sticky-buy-{{ ai_gen_id }}__image" src="{{ product.featured_image | image_url: width: 360 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="{{ block.settings.image_size }}" height="{{ block.settings.image_size }}" loading="lazy">{% else %}<div class="ai-sticky-buy-{{ ai_gen_id }}__image">{{ 'product-1' | placeholder_svg_tag }}</div>{% endif %}<div class="ai-sticky-buy-{{ ai_gen_id }}__copy"><h2 class="ai-sticky-buy-{{ ai_gen_id }}__title">{{ product.title | escape }}</h2>{% if block.settings.description != blank %}<p class="ai-sticky-buy-{{ ai_gen_id }}__text">{{ block.settings.description | escape }}</p>{% endif %}<div class="ai-sticky-buy-{{ ai_gen_id }}__price">{{ active_variant.price | money }}</div></div>{% form 'product', product, class: form_class %}<input type="hidden" name="id" value="{{ active_variant.id }}"><button class="ai-sticky-buy-{{ ai_gen_id }}__button" type="submit" {% unless active_variant.available %}disabled{% endunless %}>{% if active_variant.available %}{{ block.settings.button_label | escape }}{% else %}售罄{% endif %}</button>{% endform %}</div></sticky-buy-bar-{{ ai_gen_id }}><script>
(function () {
  const tag = 'sticky-buy-bar-{{ ai_gen_id }}';
  if (customElements.get(tag)) return;

  class StickyBuyBar extends HTMLElement {
    connectedCallback() {
      this.dismissed = false;
      this.frame = null;
      this.closeButton = this.querySelector('.ai-sticky-buy-{{ ai_gen_id }}__close');
      this.onClose = () => {
        this.dismissed = true;
        this.updateVisibility();
      };
      this.closeButton.addEventListener('click', this.onClose);
      this.scheduleUpdate = () => {
        if (this.frame !== null) return;
        this.frame = requestAnimationFrame(() => {
          this.frame = null;
          this.updateVisibility();
        });
      };
      window.addEventListener('scroll', this.scheduleUpdate, { passive: true });
      window.addEventListener('resize', this.scheduleUpdate);
      document.addEventListener('shopify:section:load', this.scheduleUpdate);
      document.addEventListener('shopify:section:unload', this.scheduleUpdate);
      this.resizeObserver = new ResizeObserver(this.scheduleUpdate);
      this.resizeObserver.observe(document.body);
      this.updateVisibility();
    }

    disconnectedCallback() {
      window.removeEventListener('scroll', this.scheduleUpdate);
      window.removeEventListener('resize', this.scheduleUpdate);
      document.removeEventListener('shopify:section:load', this.scheduleUpdate);
      document.removeEventListener('shopify:section:unload', this.scheduleUpdate);
      this.closeButton.removeEventListener('click', this.onClose);
      this.resizeObserver.disconnect();
      if (this.frame !== null) cancelAnimationFrame(this.frame);
    }

    updateVisibility() {
      // This section ID is shared by the shipping/returns benefits in all product templates.
      // Resolve the anchors again so theme-editor section replacements are also supported.
      const benefits = document.querySelector('[id^="shopify-section-"][id$="__section_eFGJfg"]');
      const related = document.querySelector('product-recommendations[data-intent="related"]');
      const start = benefits && (benefits.querySelector('.icon-block') || benefits);
      const end = related && (related.querySelector('.section-resource-list__content') || related);
      const viewportHeight = document.documentElement.clientHeight;
      const shouldShow = Boolean(!this.dismissed && start && end &&
        start.getClientRects().length && end.getClientRects().length &&
        start.getBoundingClientRect().top < viewportHeight &&
        end.getBoundingClientRect().top >= viewportHeight);
      this.classList.toggle('is-visible', shouldShow);
    }
  }

  customElements.define(tag, StickyBuyBar);
})();
</script>{% endif %}{% schema %}{"name":"产品页悬浮加购条","settings":[{"type":"range","id":"desktop_width_percent","label":"桌面宽度","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"color","id":"background_color","label":"背景颜色","default":"#FFFFFF"},{"type":"color","id":"title_color","label":"标题颜色","default":"#111111"},{"type":"color","id":"text_color","label":"文本颜色","default":"#333333"},{"type":"color","id":"price_color","label":"价格颜色","default":"#111111"},{"type":"color","id":"button_color","label":"按钮背景","default":"#000000"},{"type":"color","id":"button_text_color","label":"按钮文字颜色","default":"#FFFFFF"},{"type":"color","id":"close_color","label":"关闭按钮颜色","default":"#333333"},{"type":"color","id":"close_hover_color","label":"关闭悬停颜色","default":"#000000"},{"type":"range","id":"image_radius","label":"图片圆角","min":0,"max":40,"step":2,"unit":"px","default":0},{"type":"range","id":"button_radius","label":"按钮圆角","min":0,"max":40,"step":2,"unit":"px","default":0},{"type":"text","id":"description","label":"产品文本","default":"匠心打造，值得信赖"},{"type":"text","id":"button_label","label":"加购按钮文字","default":"加入购物车"},{"type":"select","id":"title_font","label":"标题字体","options":[{"value":"heading","label":"标题"},{"value":"subheading","label":"副标题"},{"value":"body","label":"文本"}],"default":"heading"},{"type":"select","id":"button_font","label":"按钮字体","options":[{"value":"heading","label":"标题"},{"value":"subheading","label":"副标题"},{"value":"body","label":"文本"}],"default":"body"},{"type":"range","id":"image_size","label":"桌面图片尺寸","min":50,"max":140,"step":5,"unit":"px","default":90},{"type":"range","id":"mobile_image_size","label":"移动图片尺寸","min":50,"max":100,"step":5,"unit":"px","default":70},{"type":"range","id":"title_size","label":"桌面标题字号","min":14,"max":32,"step":1,"unit":"px","default":20},{"type":"range","id":"mobile_title_size","label":"移动标题字号","min":12,"max":24,"step":1,"unit":"px","default":16},{"type":"range","id":"text_size","label":"文本字号","min":12,"max":20,"step":1,"unit":"px","default":14},{"type":"range","id":"price_size","label":"价格字号","min":14,"max":28,"step":1,"unit":"px","default":18},{"type":"select","id":"title_weight","label":"标题字重","options":[{"value":"400","label":"常规"},{"value":"500","label":"中等"},{"value":"600","label":"半粗"},{"value":"700","label":"粗体"}],"default":"600"},{"type":"select","id":"price_weight","label":"价格字重","options":[{"value":"400","label":"常规"},{"value":"500","label":"中等"},{"value":"600","label":"半粗"},{"value":"700","label":"粗体"}],"default":"600"},{"type":"range","id":"copy_price_gap","label":"文本与价格间距","min":0,"max":30,"step":2,"unit":"px","default":8}],"presets":[{"name":"产品页悬浮加购条"}],"tag":null,"class":"sticky-buy-bar"}{% endschema %}

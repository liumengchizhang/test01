{% capture children %}
  {% content_for 'blocks' %}
{% endcapture %}

{% assign shipping_scroll_class = '' %}
{% if block.settings.shipping_table_scroll %}
  {% assign shipping_scroll_class = 'huusk-shipping-table-scroll' %}
{% endif %}

{% if block.settings.enable_multicolumn_tabs %}
  {% render 'huusk-multicolumn-tabs',
    block: block,
    children: children,
    shipping_scroll_class: shipping_scroll_class
  %}
{% else %}
  {% render 'group',
    children: children,
    settings: block.settings,
    shopify_attributes: block.shopify_attributes,
    class: shipping_scroll_class
  %}
{% endif %}

{% if block.settings.shipping_table_scroll %}
  <style>
    @media screen and (max-width: 767px) {
      .huusk-shipping-table-scroll {
        display: block;
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        box-sizing: border-box;
        overflow-x: auto !important;
        -webkit-overflow-scrolling: touch;
      }

      .huusk-shipping-table-scroll > .group-block-content {
        width: 900px !important;
        min-width: 900px !important;
        max-width: none !important;
        box-sizing: border-box;
        align-items: stretch;
      }

      .huusk-shipping-table-scroll [id^="Grid-"] {
        display: grid !important;
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
      }

      .huusk-shipping-table-scroll [id^="Grid-"] > .grid__item {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0;
        box-sizing: border-box;
      }
    }
  </style>
{% endif %}



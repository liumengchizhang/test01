{% doc %}
  @prompt
    生成一个在画面底部的满幅长条弹窗，里面有背景颜色，标题及字体大小颜色，文本及字体大小颜色，加入购物车按钮，产品图，价格，布局：图片在左上，大小可调，价格在图片下方，上下左右可调，最右是加购按钮, 增加价格颜色选项，把×放到右上角，颜色可选, 价格字号也要可选, 把价格放到标题和文本下面，左边才是图片, 标题字体可选, 标题字体可选的是标题/副标题/文本, 标题和价格各增加可选字重
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign popup_product = block.settings.product %}{% if popup_product == blank and product != blank %}{% assign popup_product = product %}{% endif %}{% if popup_product != blank %}{% assign popup_variant = popup_product.selected_or_first_available_variant %}{% endif %}
{% case block.settings.heading_font_type %}{% when 'heading' %}{% assign selected_heading_font = settings.type_header_font %}{% when 'subheading' %}{% assign selected_heading_font = settings.type_subheading_font %}{% else %}{% assign selected_heading_font = settings.type_body_font %}{% endcase %}
{% style %}
{{ selected_heading_font | font_face: font_display: 'swap' }}
.ai-bottom-offer-{{ ai_gen_id }}{display:block;position:fixed;z-index:50;left:0;bottom:0;width:100%;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};box-shadow:0 -4px 22px rgba(0,0,0,.14)}.ai-bottom-offer-{{ ai_gen_id }}[hidden]{display:none}.ai-bottom-offer-{{ ai_gen_id }}__inner{box-sizing:border-box;position:relative;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;min-height:{{ block.settings.bar_height }}px;padding:{{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;display:grid;grid-template-columns:{{ block.settings.image_size }}px minmax(0,1fr) auto;gap:20px;align-items:center}.ai-bottom-offer-{{ ai_gen_id }}__product{display:flex;align-items:center;justify-content:center}.ai-bottom-offer-{{ ai_gen_id }}__image,.ai-bottom-offer-{{ ai_gen_id }}__placeholder{width:{{ block.settings.image_size }}px;height:{{ block.settings.image_size }}px;object-fit:cover;display:block}.ai-bottom-offer-{{ ai_gen_id }}__placeholder{background:#f1f0ed}.ai-bottom-offer-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%;display:block}.ai-bottom-offer-{{ ai_gen_id }}__copy{min-width:0;padding-right:24px}.ai-bottom-offer-{{ ai_gen_id }}__heading{margin:0 0 6px;color:{{ block.settings.heading_color }};font-family:{{ selected_heading_font.family }},{{ selected_heading_font.fallback_families }};font-style:{{ selected_heading_font.style }};font-weight:{{ block.settings.heading_weight }};font-size:{{ block.settings.heading_size }}px;line-height:1.2}.ai-bottom-offer-{{ ai_gen_id }}__text{color:{{ block.settings.text_color }};font-size:{{ block.settings.text_size }}px;line-height:1.45}.ai-bottom-offer-{{ ai_gen_id }}__text p{margin:0}.ai-bottom-offer-{{ ai_gen_id }}__price{display:block;margin-top:8px;color:{{ block.settings.price_color }};font-size:{{ block.settings.price_size }}px;font-weight:{{ block.settings.price_weight }}}.ai-bottom-offer-{{ ai_gen_id }}__actions{display:flex;align-items:center;gap:12px}.ai-bottom-offer-{{ ai_gen_id }}__add{min-height:48px;padding:0 24px;border:1px solid {{ block.settings.button_background }};background:{{ block.settings.button_background }};color:{{ block.settings.button_text_color }};font:inherit;font-size:14px;font-weight:600;cursor:pointer}.ai-bottom-offer-{{ ai_gen_id }}__add:hover{opacity:.88}.ai-bottom-offer-{{ ai_gen_id }}__add:focus-visible,.ai-bottom-offer-{{ ai_gen_id }}__close:focus-visible{outline:2px solid currentColor;outline-offset:3px}.ai-bottom-offer-{{ ai_gen_id }}__close{position:absolute;top:8px;right:8px;z-index:2;border:0;padding:8px;background:transparent;color:{{ block.settings.close_color }};font-size:22px;line-height:1;cursor:pointer}.ai-bottom-offer-{{ ai_gen_id }}__status{font-size:13px}@media(max-width:749px){.ai-bottom-offer-{{ ai_gen_id }}__inner{width:100%;grid-template-columns:{{ block.settings.mobile_image_size }}px minmax(0,1fr) auto;gap:12px;padding:20px 12px 12px;min-height:0}.ai-bottom-offer-{{ ai_gen_id }}__image,.ai-bottom-offer-{{ ai_gen_id }}__placeholder{width:{{ block.settings.mobile_image_size }}px;height:{{ block.settings.mobile_image_size }}px}.ai-bottom-offer-{{ ai_gen_id }}__heading{font-size:{{ block.settings.mobile_heading_size }}px}.ai-bottom-offer-{{ ai_gen_id }}__text{font-size:{{ block.settings.mobile_text_size }}px}.ai-bottom-offer-{{ ai_gen_id }}__price{font-size:{{ block.settings.mobile_price_size }}px}.ai-bottom-offer-{{ ai_gen_id }}__add{min-height:42px;padding:0 12px;font-size:12px}.ai-bottom-offer-{{ ai_gen_id }}__close{top:0;right:2px}}
{% endstyle %}
<bottom-offer-{{ ai_gen_id }} class="ai-bottom-offer-{{ ai_gen_id }}" {{ block.shopify_attributes }} {% unless block.settings.show_on_load %}hidden{% endunless %}>{% if popup_product != blank %}<div class="ai-bottom-offer-{{ ai_gen_id }}__inner"><div class="ai-bottom-offer-{{ ai_gen_id }}__product">{% if popup_product.featured_image %}<img class="ai-bottom-offer-{{ ai_gen_id }}__image" src="{{ popup_product.featured_image | image_url: width: 400 }}" alt="{{ popup_product.featured_image.alt | default: popup_product.title | escape }}" width="{{ block.settings.image_size }}" height="{{ block.settings.image_size }}" loading="lazy">{% else %}<div class="ai-bottom-offer-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}</div><div class="ai-bottom-offer-{{ ai_gen_id }}__copy">{% if block.settings.heading != blank %}<h2 class="ai-bottom-offer-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}{% if block.settings.body != blank %}<div class="ai-bottom-offer-{{ ai_gen_id }}__text">{{ block.settings.body }}</div>{% endif %}<span class="ai-bottom-offer-{{ ai_gen_id }}__price">{{ popup_variant.price | money }}</span></div><div class="ai-bottom-offer-{{ ai_gen_id }}__actions"><form class="ai-bottom-offer-{{ ai_gen_id }}__form" action="{{ routes.cart_add_url }}" method="post"><input type="hidden" name="id" value="{{ popup_variant.id }}"><input type="hidden" name="quantity" value="1"><button class="ai-bottom-offer-{{ ai_gen_id }}__add" type="submit" {% unless popup_variant.available %}disabled{% endunless %}>{% if popup_variant.available %}{{ block.settings.button_label | escape }}{% else %}售罄{% endif %}</button></form><span class="ai-bottom-offer-{{ ai_gen_id }}__status" aria-live="polite"></span></div><button class="ai-bottom-offer-{{ ai_gen_id }}__close" type="button" aria-label="关闭弹窗">×</button></div>{% else %}<div class="ai-bottom-offer-{{ ai_gen_id }}__inner"><span>请在设置中选择产品。</span><button class="ai-bottom-offer-{{ ai_gen_id }}__close" type="button" aria-label="关闭弹窗">×</button></div>{% endif %}</bottom-offer-{{ ai_gen_id }}>
<script>(function(){const tagName='bottom-offer-{{ ai_gen_id }}';if(customElements.get(tagName))return;class BottomOffer extends HTMLElement{connectedCallback(){const close=this.querySelector('.ai-bottom-offer-{{ ai_gen_id }}__close');if(close)close.addEventListener('click',()=>{this.hidden=true});const form=this.querySelector('.ai-bottom-offer-{{ ai_gen_id }}__form');if(!form)return;form.addEventListener('submit',async(event)=>{event.preventDefault();const button=form.querySelector('button');const status=this.querySelector('.ai-bottom-offer-{{ ai_gen_id }}__status');button.disabled=true;try{const response=await fetch(form.action+'.js',{method:'POST',headers:{'Accept':'application/json'},body:new FormData(form)});if(!response.ok)throw new Error();status.textContent='已加入购物车';document.dispatchEvent(new CustomEvent('cart:refresh',{bubbles:true}))}catch(error){status.textContent='加入购物车失败，请重试'}finally{button.disabled=false}})}}customElements.define(tagName,BottomOffer)})();</script>
{% schema %}{"name":"底部加购条","settings":[{"type":"product","id":"product","label":"产品"},{"type":"checkbox","id":"show_on_load","label":"页面加载时显示","default":true},{"type":"text","id":"heading","label":"标题","default":"匠心锻造，日常相伴"},{"type":"select","id":"heading_font_type","label":"标题字体类型","options":[{"value":"heading","label":"标题"},{"value":"subheading","label":"副标题"},{"value":"body","label":"文本"}],"default":"heading"},{"type":"select","id":"heading_weight","label":"标题字重","options":[{"value":"400","label":"常规"},{"value":"500","label":"中等"},{"value":"600","label":"半粗"},{"value":"700","label":"粗体"}],"default":"600"},{"type":"richtext","id":"body","label":"文本","default":"<p>探索精工打造的厨房刀具，提升每一次料理体验。</p>"},{"type":"text","id":"button_label","label":"按钮文字","default":"加入购物车"},{"type":"range","id":"desktop_width_percent","label":"桌面内容宽度","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"bar_height","label":"长条最小高度","min":80,"max":200,"step":10,"unit":"px","default":120},{"type":"range","id":"image_size","label":"桌面图片大小","min":40,"max":120,"step":5,"unit":"px","default":80},{"type":"range","id":"mobile_image_size","label":"移动端图片大小","min":36,"max":80,"step":4,"unit":"px","default":56},{"type":"range","id":"padding_vertical","label":"上下内边距","min":8,"max":40,"step":4,"unit":"px","default":20},{"type":"range","id":"padding_horizontal","label":"左右内边距","min":8,"max":60,"step":4,"unit":"px","default":32},{"type":"range","id":"heading_size","label":"标题字号","min":16,"max":40,"step":2,"unit":"px","default":24},{"type":"range","id":"mobile_heading_size","label":"移动端标题字号","min":14,"max":28,"step":2,"unit":"px","default":18},{"type":"range","id":"text_size","label":"文本字号","min":12,"max":24,"step":2,"unit":"px","default":16},{"type":"range","id":"mobile_text_size","label":"移动端文本字号","min":10,"max":18,"step":2,"unit":"px","default":12},{"type":"range","id":"price_size","label":"价格字号","min":12,"max":32,"step":2,"unit":"px","default":16},{"type":"range","id":"mobile_price_size","label":"移动端价格字号","min":10,"max":24,"step":2,"unit":"px","default":14},{"type":"select","id":"price_weight","label":"价格字重","options":[{"value":"400","label":"常规"},{"value":"500","label":"中等"},{"value":"600","label":"半粗"},{"value":"700","label":"粗体"}],"default":"600"},{"type":"color","id":"background_color","label":"背景颜色","default":"#F5F3EF"},{"type":"color","id":"heading_color","label":"标题颜色","default":"#171717"},{"type":"color","id":"text_color","label":"文本颜色","default":"#333333"},{"type":"color","id":"price_color","label":"价格颜色","default":"#171717"},{"type":"color","id":"close_color","label":"关闭按钮颜色","default":"#333333"},{"type":"color","id":"button_background","label":"按钮背景","default":"#171717"},{"type":"color","id":"button_text_color","label":"按钮文字颜色","default":"#FFFFFF"}],"presets":[{"name":"底部加购条"}],"tag":null,"class":"bottom-offer-block"}{% endschema %}
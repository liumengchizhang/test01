{% doc %}
  @prompt
    生成一个独属于一个产品落地页的、在画面底部的满幅长条弹窗，里面有背景颜色，标题及字体大小颜色，文本及字体大小颜色，加入购物车按钮，产品图，价格，布局：图片在左上，大小可调，价格在图片下方，上下左右可调，最右是加购按钮, 增加价格颜色选项，把×放到右上角，颜色可选, 价格字号也要可选, 把价格放到标题和文本下面，左边才是图片, 标题字体可选, 标题和价格各增加可选字重, 要看产品信息时不出现，划过产品信息弹上来, 标题字体和文本字体要在标题/副标题/文本中选, 再增加一个间隙大小选项，主要是为了增加标题文本和价格之间的间隙, 价格在标题和文本下面，图片的右边, 移动段布局是左上图片，右上是左对齐的标题、文本和价格，图片的最上端和标题的最上端对齐，图片最下端和价格最下端对齐，下面是一整长条按钮。, 移动端图片还是正方形, 选项栏可翻译成中文, 图片尺寸分为电脑端和移动端, 桌面端和移动端图片比例始终保持1：1, ×增加一个悬停颜色选项, 标题字号也分为移动端和电脑端, 移动端的：图片加标题文本和价格，再加按钮，这些所有内容一起，右边不要留太多空白，参考左边边距，左右间距要一致, 不要和产品信息同时出现，划过产品信息才弹出, 怎么一直不弹出了，我要滑到产品选项卡时就弹出来, 要往下划过产品信息才弹出，不要一开始就出现, 标题和按钮字体可从（标题/副标题/文本）中选，其余不变
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}{% assign ai_product = product %}{% if ai_product == blank %}{% assign ai_product = block.settings.product %}{% endif %}{% if ai_product != blank %}{% assign ai_variant = ai_product.selected_or_first_available_variant %}{% style %}.ai-bar-{{ ai_gen_id }}{display:block;position:fixed;z-index:50;left:0;right:0;bottom:0;width:100%;background:{{ block.settings.bg }};box-shadow:0 -5px 24px rgba(0,0,0,.12);transform:translateY(110%);visibility:hidden;transition:transform .25s ease,visibility .25s ease}.ai-bar-{{ ai_gen_id }}.is-open{transform:translateY(0);visibility:visible}.ai-bar-{{ ai_gen_id }}__inner{position:relative;display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:16px;padding:14px 24px;width:100%;max-width:{{ block.settings.desktop_width }}%;margin:auto;box-sizing:border-box}.ai-bar-{{ ai_gen_id }}__image,.ai-bar-{{ ai_gen_id }}__image-wrap{display:block;width:{{ block.settings.desktop_img }}px;height:{{ block.settings.desktop_img }}px;aspect-ratio:1;object-fit:cover}.ai-bar-{{ ai_gen_id }}__image-wrap{background:#eee}.ai-bar-{{ ai_gen_id }}__image-wrap svg{width:100%;height:100%}.ai-bar-{{ ai_gen_id }}__copy{min-width:0}.ai-bar-{{ ai_gen_id }}__title{margin:0 0 5px;color:{{ block.settings.title_color }};font-size:{{ block.settings.title_desktop }}px;font-weight:{{ block.settings.title_weight }};line-height:1.2}{% if block.settings.title_font == 'heading' %}.ai-bar-{{ ai_gen_id }}__title{font-family:{{ settings.type_header_font.family }},{{ settings.type_header_font.fallback_families }}}{% elsif block.settings.title_font == 'subheading' %}.ai-bar-{{ ai_gen_id }}__title{font-family:{{ settings.type_subheading_font.family }},{{ settings.type_subheading_font.fallback_families }}}{% else %}.ai-bar-{{ ai_gen_id }}__title{font-family:{{ settings.type_body_font.family }},{{ settings.type_body_font.fallback_families }}}{% endif %}.ai-bar-{{ ai_gen_id }}__desc{margin:0;color:{{ block.settings.text_color }};font-size:14px;line-height:1.4}.ai-bar-{{ ai_gen_id }}__price{margin-top:12px;color:{{ block.settings.price_color }};font-size:18px;font-weight:600}.ai-bar-{{ ai_gen_id }}__actions{padding-right:36px}.ai-bar-{{ ai_gen_id }}__button{min-height:48px;padding:12px 24px;border:0;background:{{ block.settings.button_bg }};color:{{ block.settings.button_color }};font:inherit;font-weight:600;cursor:pointer}{% if block.settings.button_font == 'heading' %}.ai-bar-{{ ai_gen_id }}__button{font-family:{{ settings.type_header_font.family }},{{ settings.type_header_font.fallback_families }}}{% elsif block.settings.button_font == 'subheading' %}.ai-bar-{{ ai_gen_id }}__button{font-family:{{ settings.type_subheading_font.family }},{{ settings.type_subheading_font.fallback_families }}}{% else %}.ai-bar-{{ ai_gen_id }}__button{font-family:{{ settings.type_body_font.family }},{{ settings.type_body_font.fallback_families }}}{% endif %}.ai-bar-{{ ai_gen_id }}__close{position:absolute;right:8px;top:6px;width:32px;height:32px;background:transparent;border:0;color:{{ block.settings.close_color }};font-size:24px;cursor:pointer}.ai-bar-{{ ai_gen_id }}__close:hover{color:{{ block.settings.close_hover }}}@media(max-width:749px){.ai-bar-{{ ai_gen_id }}__inner{grid-template-columns:{{ block.settings.mobile_img }}px minmax(0,1fr);grid-template-rows:auto auto;column-gap:12px;row-gap:12px;padding:12px;max-width:100%}.ai-bar-{{ ai_gen_id }}__image,.ai-bar-{{ ai_gen_id }}__image-wrap{width:{{ block.settings.mobile_img }}px;height:{{ block.settings.mobile_img }}px;aspect-ratio:1}.ai-bar-{{ ai_gen_id }}__copy{grid-column:2;grid-row:1;min-height:{{ block.settings.mobile_img }}px;display:flex;flex-direction:column;align-items:flex-start;justify-content:space-between}.ai-bar-{{ ai_gen_id }}__title{font-size:{{ block.settings.title_mobile }}px;margin:0 0 4px}.ai-bar-{{ ai_gen_id }}__price{margin-top:4px;font-size:16px}.ai-bar-{{ ai_gen_id }}__actions{grid-column:1/-1;grid-row:2;width:100%;padding:0}.ai-bar-{{ ai_gen_id }}__actions form,.ai-bar-{{ ai_gen_id }}__button{display:block;width:100%;box-sizing:border-box}}{% endstyle %}<sticky-buy-bar-{{ ai_gen_id }} class="ai-bar-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-bar-{{ ai_gen_id }}__inner"><div>{% if ai_product.featured_image %}<img class="ai-bar-{{ ai_gen_id }}__image" src="{{ ai_product.featured_image | image_url: width: 400 }}" alt="{{ ai_product.featured_image.alt | default: ai_product.title | escape }}" width="{{ block.settings.desktop_img }}" height="{{ block.settings.desktop_img }}" loading="lazy">{% else %}<div class="ai-bar-{{ ai_gen_id }}__image-wrap">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}</div><div class="ai-bar-{{ ai_gen_id }}__copy"><h2 class="ai-bar-{{ ai_gen_id }}__title">{{ ai_product.title | escape }}</h2>{% if block.settings.description != blank %}<p class="ai-bar-{{ ai_gen_id }}__desc">{{ block.settings.description | escape }}</p>{% endif %}<div class="ai-bar-{{ ai_gen_id }}__price">{{ ai_variant.price | money }}</div></div><div class="ai-bar-{{ ai_gen_id }}__actions">{% form 'product', ai_product %}<input type="hidden" name="id" value="{{ ai_variant.id }}"><button class="ai-bar-{{ ai_gen_id }}__button" type="submit" {% unless ai_variant.available %}disabled{% endunless %}>{{ block.settings.button_label | escape }}</button>{% endform %}</div><button class="ai-bar-{{ ai_gen_id }}__close" type="button" aria-label="关闭购买栏" data-close>×</button></div></sticky-buy-bar-{{ ai_gen_id }}><script>(function(){const tag='sticky-buy-bar-{{ ai_gen_id }}';if(customElements.get(tag))return;class Bar extends HTMLElement{connectedCallback(){this.closed=false;this.querySelector('[data-close]').addEventListener('click',()=>{this.closed=true;this.classList.remove('is-open')});this.target=document.querySelector('.productView-details, .productView-info, .product__info-container');if(!this.target)this.target=document.querySelector('[data-product-info], .productView-options, .product-form');if(!this.target)return;this.checkVisibility=()=>{if(this.closed)return;const r=this.target.getBoundingClientRect();this.classList.toggle('is-open',r.bottom<=0)};window.addEventListener('scroll',this.checkVisibility,{passive:true});window.addEventListener('resize',this.checkVisibility);this.checkVisibility()}disconnectedCallback(){window.removeEventListener('scroll',this.checkVisibility);window.removeEventListener('resize',this.checkVisibility)}}customElements.define(tag,Bar)})();</script>{% endif %}{% schema %}{"name":"产品悬浮购买栏","settings":[{"type":"product","id":"product","label":"指定产品（可选）"},{"type":"textarea","id":"description","label":"产品说明","default":"精工锻造，经久耐用。"},{"type":"text","id":"button_label","label":"加购按钮文字","default":"加入购物车"},{"type":"range","id":"desktop_width","label":"桌面端宽度","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"desktop_img","label":"电脑端图片尺寸","min":48,"max":160,"step":4,"unit":"px","default":72},{"type":"range","id":"mobile_img","label":"移动端图片尺寸","min":40,"max":120,"step":4,"unit":"px","default":64},{"type":"range","id":"title_desktop","label":"电脑端标题字号","min":14,"max":36,"step":2,"unit":"px","default":20},{"type":"range","id":"title_mobile","label":"移动端标题字号","min":12,"max":28,"step":2,"unit":"px","default":16},{"type":"select","id":"title_font","label":"标题字体","options":[{"value":"heading","label":"标题"},{"value":"subheading","label":"副标题"},{"value":"body","label":"文本"}],"default":"heading"},{"type":"select","id":"button_font","label":"按钮字体","options":[{"value":"heading","label":"标题"},{"value":"subheading","label":"副标题"},{"value":"body","label":"文本"}],"default":"body"},{"type":"select","id":"title_weight","label":"标题字重","options":[{"value":"400","label":"常规"},{"value":"500","label":"中等"},{"value":"600","label":"半粗"},{"value":"700","label":"粗体"}],"default":"600"},{"type":"color","id":"bg","label":"背景颜色","default":"#FFFFFF"},{"type":"color","id":"title_color","label":"标题颜色","default":"#161616"},{"type":"color","id":"text_color","label":"文本颜色","default":"#333333"},{"type":"color","id":"price_color","label":"价格颜色","default":"#161616"},{"type":"color","id":"button_bg","label":"按钮背景色","default":"#161616"},{"type":"color","id":"button_color","label":"按钮文字颜色","default":"#FFFFFF"},{"type":"color","id":"close_color","label":"关闭图标颜色","default":"#161616"},{"type":"color","id":"close_hover","label":"关闭图标悬停颜色","default":"#B42318"}],"presets":[{"name":"产品悬浮购买栏"}],"tag":null,"class":"sticky-product-bar-block"}{% endschema %}
{% doc %}
  @prompt
    副标题文字, 字号可选择范围再大一些，字号选择分电脑端和移动端可选，字号到100, 增加行间距和调整选项, 文字框里要可以换行，, 要副标题字体, 行间距也要分电脑端和手机端, 行间距要可以小于一，最小可以是0, 增加上下左右的填充按钮
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-subtitle-block-{{ ai_gen_id }} {
    display: block;
    box-sizing: border-box;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.padding_top }}px {{ block.settings.padding_right }}px {{ block.settings.padding_bottom }}px {{ block.settings.padding_left }}px;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.subtitle_font.family }}, {{ block.settings.subtitle_font.fallback_families }};
    font-style: {{ block.settings.subtitle_font.style }};
    font-weight: {{ block.settings.subtitle_font.weight }};
    font-size: {{ block.settings.desktop_font_size }}px;
    line-height: {{ block.settings.desktop_line_height }};
    text-align: {{ block.settings.alignment }};
    white-space: pre-line;
    overflow-wrap: anywhere;
  }

  @media screen and (max-width: 749px) {
    .ai-subtitle-block-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_font_size }}px;
      line-height: {{ block.settings.mobile_line_height }};
    }
  }
{% endstyle %}

<div class="ai-subtitle-block-{{ ai_gen_id }}" {{ block.shopify_attributes }}>{{ block.settings.subtitle | escape | newline_to_br }}</div>

{% schema %}
{
  "name": "Subtitle text",
  "settings": [
    { "type": "textarea", "id": "subtitle", "label": "Subtitle text", "default": "Crafted for precision\\nMade for everyday cooking" },
    { "type": "font_picker", "id": "subtitle_font", "label": "Subtitle font", "default": "assistant_n4" },
    { "type": "range", "id": "desktop_font_size", "label": "Desktop font size", "min": 10, "max": 100, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "mobile_font_size", "label": "Mobile font size", "min": 10, "max": 100, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "desktop_line_height", "label": "Desktop line spacing", "min": 0, "max": 3, "step": 0.1, "default": 1.4 },
    { "type": "range", "id": "mobile_line_height", "label": "Mobile line spacing", "min": 0, "max": 3, "step": 0.1, "default": 1.4 },
    { "type": "select", "id": "alignment", "label": "Text alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Padding" },
    { "type": "range", "id": "padding_top", "label": "Top", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_right", "label": "Right", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_left", "label": "Left", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 0 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#FFFFFF" }
  ],
  "presets": [{ "name": "Subtitle text" }],
  "tag": null,
  "class": "subtitle-text-block"
}
{% endschema %}
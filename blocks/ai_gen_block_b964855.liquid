{% doc %}
  @prompt
    生成一个独属于一个产品落地页的、在画面底部的满幅长条弹窗，里面有背景颜色，标题及字体大小颜色，文本及字体大小颜色，加入购物车按钮，产品图，价格，布局：图片在左上，大小可调，价格在图片下方，上下左右可调，最右是加购按钮, 增加价格颜色选项，把×放到右上角，颜色可选, 价格字号也要可选, 把价格放到标题和文本下面，左边才是图片, 标题字体可选, 标题和价格各增加可选字重, 要刚打开页面看不到，划过产品信息就弹上来, 标题字体和文本字体要在标题/副标题/文本中选, 要划过产品信息才能看到，看产品信息时不出现, 再增加一个间隙大小选项，主要是为了增加标题文本和价格之间的间隙
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign popup_product = product %}
{% if popup_product == blank and block.settings.product != blank %}{% assign popup_product = block.settings.product %}{% endif %}
{% if popup_product != blank %}
{% assign popup_variant = popup_product.selected_or_first_available_variant %}
{% style %}
.ai-sticky-offer-{{ ai_gen_id }}{display:block;position:fixed;z-index:50;left:0;right:0;bottom:0;width:100%;box-sizing:border-box;background:{{ block.settings.background_color }};padding:{{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;box-shadow:0 -6px 24px rgba(0,0,0,.14);opacity:0;visibility:hidden;transform:translateY(110%);transition:opacity .25s ease,transform .25s ease,visibility .25s ease}
.ai-sticky-offer-{{ ai_gen_id }}.is-visible{opacity:1;visibility:visible;transform:translateY(0)}
.ai-sticky-offer-{{ ai_gen_id }}__inner{position:relative;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;display:grid;grid-template-columns:{{ block.settings.image_size }}px minmax(0,1fr) auto;align-items:center;gap:24px;padding-right:32px}
.ai-sticky-offer-{{ ai_gen_id }}__image,.ai-sticky-offer-{{ ai_gen_id }}__placeholder{display:block;width:{{ block.settings.image_size }}px;height:{{ block.settings.image_size }}px;object-fit:cover}.ai-sticky-offer-{{ ai_gen_id }}__placeholder{display:flex;align-items:center;justify-content:center;background:#eee}.ai-sticky-offer-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%}
.ai-sticky-offer-{{ ai_gen_id }}__copy{min-width:0;display:flex;flex-direction:column;align-items:flex-start;gap:{{ block.settings.content_gap }}px}
.ai-sticky-offer-{{ ai_gen_id }}__title{margin:0;color:{{ block.settings.title_color }};font-family:{% if block.settings.title_font == 'heading' %}{{ settings.type_header_font.family }},{{ settings.type_header_font.fallback_families }}{% elsif block.settings.title_font == 'subheading' %}{{ settings.type_subheading_font.family }},{{ settings.type_subheading_font.fallback_families }}{% else %}{{ settings.type_body_font.family }},{{ settings.type_body_font.fallback_families }}{% endif %};font-size:{{ block.settings.title_size }}px;font-weight:{{ block.settings.title_weight }};line-height:1.2}
.ai-sticky-offer-{{ ai_gen_id }}__text{margin:0;color:{{ block.settings.text_color }};font-family:{% if block.settings.text_font == 'heading' %}{{ settings.type_header_font.family }},{{ settings.type_header_font.fallback_families }}{% elsif block.settings.text_font == 'subheading' %}{{ settings.type_subheading_font.family }},{{ settings.type_subheading_font.fallback_families }}{% else %}{{ settings.type_body_font.family }},{{ settings.type_body_font.fallback_families }}{% endif %};font-size:{{ block.settings.text_size }}px}
.ai-sticky-offer-{{ ai_gen_id }}__price{color:{{ block.settings.price_color }};font-size:{{ block.settings.price_size }}px;font-weight:{{ block.settings.price_weight }};line-height:1.2}.ai-sticky-offer-{{ ai_gen_id }}__form{margin:0}.ai-sticky-offer-{{ ai_gen_id }}__button{min-height:48px;padding:12px 26px;border:1px solid {{ block.settings.button_color }};border-radius:{{ block.settings.button_radius }}px;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};font:inherit;cursor:pointer}.ai-sticky-offer-{{ ai_gen_id }}__button:disabled{opacity:.55;cursor:not-allowed}.ai-sticky-offer-{{ ai_gen_id }}__close{position:absolute;top:-10px;right:0;width:32px;height:32px;display:flex;align-items:center;justify-content:center;border:0;background:transparent;color:{{ block.settings.close_color }};font-size:24px;cursor:pointer}.ai-sticky-offer-{{ ai_gen_id }} :focus-visible{outline:2px solid currentColor;outline-offset:3px}
@media(max-width:749px){.ai-sticky-offer-{{ ai_gen_id }}{padding:12px}.ai-sticky-offer-{{ ai_gen_id }}__inner{width:100%;grid-template-columns:{{ block.settings.mobile_image_size }}px minmax(0,1fr);gap:12px;padding-right:26px}.ai-sticky-offer-{{ ai_gen_id }}__image,.ai-sticky-offer-{{ ai_gen_id }}__placeholder{width:{{ block.settings.mobile_image_size }}px;height:{{ block.settings.mobile_image_size }}px}.ai-sticky-offer-{{ ai_gen_id }}__button{grid-column:2;justify-self:start;min-height:42px;padding:9px 16px}.ai-sticky-offer-{{ ai_gen_id }}__title{font-size:{{ block.settings.mobile_title_size }}px}}
@media(prefers-reduced-motion:reduce){.ai-sticky-offer-{{ ai_gen_id }}{transition:none}}
{% endstyle %}
<product-sticky-offer-{{ ai_gen_id }} class="ai-sticky-offer-{{ ai_gen_id }}" data-trigger="{{ block.settings.trigger_selector | escape }}" aria-hidden="true" {{ block.shopify_attributes }}><div class="ai-sticky-offer-{{ ai_gen_id }}__inner">
{% if popup_product.featured_image %}<img class="ai-sticky-offer-{{ ai_gen_id }}__image" src="{{ popup_product.featured_image | image_url: width: 400 }}" alt="{{ popup_product.featured_image.alt | default: popup_product.title | escape }}" loading="lazy" width="{{ block.settings.image_size }}" height="{{ block.settings.image_size }}">{% else %}<div class="ai-sticky-offer-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}
<div class="ai-sticky-offer-{{ ai_gen_id }}__copy"><h2 class="ai-sticky-offer-{{ ai_gen_id }}__title">{{ block.settings.title | default: popup_product.title | escape }}</h2>{% if block.settings.subtitle != blank %}<p class="ai-sticky-offer-{{ ai_gen_id }}__text">{{ block.settings.subtitle | escape }}</p>{% endif %}{% if block.settings.body_text != blank %}<p class="ai-sticky-offer-{{ ai_gen_id }}__text">{{ block.settings.body_text | escape }}</p>{% endif %}<div class="ai-sticky-offer-{{ ai_gen_id }}__price">{{ popup_variant.price | money }}</div></div>
{% form 'product', popup_product, class: 'ai-sticky-offer-form' %}<input type="hidden" name="id" value="{{ popup_variant.id }}"><button class="ai-sticky-offer-{{ ai_gen_id }}__button" type="submit" {% unless popup_variant.available %}disabled{% endunless %}>{{ block.settings.button_label | escape }}</button>{% endform %}<button type="button" class="ai-sticky-offer-{{ ai_gen_id }}__close" aria-label="关闭弹窗">×</button></div></product-sticky-offer-{{ ai_gen_id }}>
<script>(function(){const tag='product-sticky-offer-{{ ai_gen_id }}';if(customElements.get(tag))return;class StickyOffer extends HTMLElement{connectedCallback(){this.dismissed=false;this.querySelector('.ai-sticky-offer-{{ ai_gen_id }}__close').addEventListener('click',()=>{this.dismissed=true;this.hide()});this.onScroll=()=>this.check();window.addEventListener('scroll',this.onScroll,{passive:true});this.onResize=()=>this.check();window.addEventListener('resize',this.onResize);this.check()}check(){if(this.dismissed)return;let target;try{target=this.dataset.trigger?document.querySelector(this.dataset.trigger):null}catch(e){}if(!target)target=document.querySelector('main product-info,main .productView,main [data-product-info],main form[action*="/cart/add"]');if(target&&target.getBoundingClientRect().bottom<=0)this.show();else this.hide()}show(){this.classList.add('is-visible');this.setAttribute('aria-hidden','false')}hide(){this.classList.remove('is-visible');this.setAttribute('aria-hidden','true')}disconnectedCallback(){window.removeEventListener('scroll',this.onScroll);window.removeEventListener('resize',this.onResize)}}customElements.define(tag,StickyOffer)})();</script>
{% endif %}
{% schema %}
{"name":"产品底部加购条","settings":[{"type":"product","id":"product","label":"指定产品（留空使用当前产品）"},{"type":"text","id":"trigger_selector","label":"产品信息 CSS 选择器","default":"main product-info","info":"产品信息完全滚出视口后显示。"},{"type":"text","id":"title","label":"标题（留空使用产品名称）"},{"type":"text","id":"subtitle","label":"副标题","default":"匠心锻造，精准切割"},{"type":"textarea","id":"body_text","label":"文本","default":"为日常料理而打造的专业刀具。"},{"type":"text","id":"button_label","label":"加购按钮文字","default":"加入购物车"},{"type":"range","id":"desktop_width_percent","label":"桌面内容宽度","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"header","content":"字体与内容"},{"type":"select","id":"title_font","label":"标题字体","options":[{"value":"heading","label":"标题字体"},{"value":"subheading","label":"副标题字体"},{"value":"body","label":"正文字体"}],"default":"heading"},{"type":"range","id":"title_size","label":"标题字号","min":14,"max":40,"step":2,"unit":"px","default":22},{"type":"select","id":"title_weight","label":"标题字重","options":[{"value":"400","label":"常规"},{"value":"500","label":"中等"},{"value":"600","label":"半粗"},{"value":"700","label":"粗体"}],"default":"600"},{"type":"select","id":"text_font","label":"副标题与文本字体","options":[{"value":"heading","label":"标题字体"},{"value":"subheading","label":"副标题字体"},{"value":"body","label":"正文字体"}],"default":"body"},{"type":"range","id":"text_size","label":"文本字号","min":12,"max":24,"step":1,"unit":"px","default":14},{"type":"range","id":"price_size","label":"价格字号","min":14,"max":36,"step":2,"unit":"px","default":20},{"type":"select","id":"price_weight","label":"价格字重","options":[{"value":"400","label":"常规"},{"value":"500","label":"中等"},{"value":"600","label":"半粗"},{"value":"700","label":"粗体"}],"default":"600"},{"type":"header","content":"图片与间距"},{"type":"range","id":"image_size","label":"桌面图片大小","min":48,"max":120,"step":6,"unit":"px","default":84},{"type":"range","id":"mobile_image_size","label":"移动端图片大小","min":40,"max":90,"step":5,"unit":"px","default":60},{"type":"range","id":"content_gap","label":"标题、文本与价格间隙","min":0,"max":32,"step":2,"unit":"px","default":8},{"type":"range","id":"padding_vertical","label":"上下内边距","min":8,"max":40,"step":4,"unit":"px","default":20},{"type":"range","id":"padding_horizontal","label":"左右内边距","min":8,"max":60,"step":4,"unit":"px","default":28},{"type":"range","id":"mobile_title_size","label":"移动端标题字号","min":14,"max":28,"step":2,"unit":"px","default":18},{"type":"header","content":"颜色与按钮"},{"type":"color","id":"background_color","label":"背景","default":"#F7F5F0"},{"type":"color","id":"title_color","label":"标题","default":"#1C1B19"},{"type":"color","id":"text_color","label":"文本","default":"#4A4844"},{"type":"color","id":"price_color","label":"价格","default":"#1C1B19"},{"type":"color","id":"close_color","label":"关闭按钮 ×","default":"#1C1B19"},{"type":"color","id":"button_color","label":"按钮背景","default":"#1C1B19"},{"type":"color","id":"button_text_color","label":"按钮文字","default":"#FFFFFF"},{"type":"range","id":"button_radius","label":"按钮圆角","min":0,"max":20,"step":2,"unit":"px","default":2}],"presets":[{"name":"产品底部加购条"}],"tag":null,"class":"product-sticky-offer-block"}
{% endschema %}